# ==============================================================================
# BIKIE PAPELERÍA - VARIABLES DE ENTORNO REQUERIDAS
# ==============================================================================

# 1. API DE GOOGLE GEMINI (Servidor)
# Requerida para el asistente virtual de compras, escáner OCR de listas escolares y matching inteligente
GEMINI_API_KEY=

# 2. CONEXIÓN A SUPABASE (Base de Datos PostgreSQL en la Nube y Realtime)
# URL del proyecto Supabase (Dashboard -> Settings -> API -> Project URL)
# Ej: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Clave pública anónima de Supabase (Dashboard -> Settings -> API -> Project API Keys -> anon public)
VITE_SUPABASE_ANON_KEY=

# Clave de servicio de Supabase (Opcional - Sólo servidor para operaciones administrativas)
SUPABASE_SERVICE_ROLE_KEY=

